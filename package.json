{
  "name": "dsh-skill-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Skill marketplace for DeepSeek Harness: search skillsmp / skillstore / skills.sh / GitHub, install and uninstall skills.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "skill-marketplace",
    "agent-skills"
  ],
  "author": "dsh-skill-market",
  "license": "MIT",
  "homepage": "https://github.com/zhao1722676538-cmd/dsh-skill-market#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhao1722676538-cmd/dsh-skill-market"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./cli": "./src/cli.js"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=20.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "MAINTENANCE.md",
    "SPEC.md",
    "PUBLISH.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs test/install.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/unit.test.mjs test/install.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "build:index": "node scripts/build-index.mjs"
  },
  "bin": {
    "dsh-skill-market": "src/cli.js"
  }
}
